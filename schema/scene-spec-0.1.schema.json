{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/animind-ai/scene-spec/schema/scene-spec-0.1.schema.json",
  "title": "scene-spec 0.1",
  "description": "一支数学讲解视频的场景描述：讲什么、画什么、什么时候动。",
  "type": "object",
  "required": [
    "spec",
    "meta",
    "beats"
  ],
  "additionalProperties": false,
  "properties": {
    "spec": {
      "const": "0.1"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "pedagogy": {
      "$ref": "#/$defs/pedagogy"
    },
    "style": {
      "$ref": "#/$defs/style"
    },
    "data": {
      "description": "数据：每项是字面量，或 {src: \"相对场景文件的路径.json\"} 从 JSON 文件读（不能是绝对路径、不能含 ..，见 curves.py，SS490–SS492）。当曲线用的点列是 [[x, y], …]，2 到 4096 个点。",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/literal"
      }
    },
    "params": {
      "description": "场景参数：随时间连续变化的数（tween 动作补间它们），组件属性里可以写引用参数的表达式。值写初值，或 {value, min?, max?}。",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/paramName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/paramDef"
      }
    },
    "objects": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/objectId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/objectDef"
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/beat"
      }
    },
    "i18n": {
      "description": "其他语言版本画面上的字：{en: {meta, style, objects, beats}}，按 id 深合并进文档；旁白写在每句的 en 里",
      "type": "object",
      "propertyNames": {
        "enum": [
          "en"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "meta": {
            "type": "object"
          },
          "style": {
            "type": "object"
          },
          "objects": {
            "type": "object"
          },
          "beats": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "objectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "beatId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "selector": {
      "type": "string",
      "description": "对象或对象的一部分：obj、obj#span、obj.part[i]、obj[i]、obj[i:j]",
      "pattern": "^[a-z][a-z0-9_]*(#[A-Za-z_][A-Za-z0-9_]*|\\.[A-Za-z_][A-Za-z0-9_]*(\\[[0-9]+(:[0-9]+)?\\])?|\\[[0-9]+(:[0-9]+)?\\])?$"
    },
    "role": {
      "enum": [
        "FG",
        "A",
        "B",
        "C",
        "HL",
        "NO",
        "DIM"
      ]
    },
    "literal": {
      "description": "字面量：数、字符串、布尔、null，或它们组成的列表 / 映射。不支持表达式。",
      "anyOf": [
        {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/literal"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/literal"
          }
        }
      ]
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "line",
        "author",
        "license"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "description": "产品线：insight 洞察短视频 | worked 例题讲解 | contest 竞赛拔高",
          "enum": [
            "insight",
            "worked",
            "contest"
          ]
        },
        "units": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[PMHJSX][0-9]{1,2}b?$"
          },
          "uniqueItems": true
        },
        "episode": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "series": {
          "description": "系列 id，供质量门槛豁免名单匹配（例如 week-1-competition）。不写则只按 meta.id 匹配。",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "grade": {
          "type": "string"
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "enum": [
            "CC-BY-4.0",
            "CC-BY-SA-4.0",
            "MIT"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "cite"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "problem",
                  "figure",
                  "text",
                  "data",
                  "other"
                ]
              },
              "cite": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "pedagogy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "insight": {
          "type": "string",
          "minLength": 1
        },
        "misconception": {
          "type": "string",
          "minLength": 1
        },
        "non_example": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "description": "proof 证明 | demo 演示 | motivation 动机 | method 方法",
          "enum": [
            "proof",
            "demo",
            "motivation",
            "method"
          ]
        },
        "landing": {
          "$ref": "#/$defs/beatId"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "canvas": {
          "enum": [
            "16:9",
            "9:16",
            "4:3"
          ]
        },
        "voice": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "persona": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "model": {
              "description": "Gemini TTS 模型。发布内容必须是 google/gemini-3.8-flash-tts；不写时检查器按这个默认值，voice 也必须用它，不能改用环境变量里的别的模型。",
              "type": "string",
              "minLength": 1
            },
            "voice": {
              "description": "Gemini TTS 声音名。发布内容必须是 Kore；不写时按 Kore。",
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "speed": {
              "description": "语速，有限数。发布内容必须是 1.0；不写时按 1.0。NaN 报 SS482，不在豁免名单里。",
              "type": "number",
              "minimum": 0.5,
              "maximum": 2
            }
          }
        },
        "quality": {
          "description": "硬门槛的容差。不写时 cue_late 为 0.4 秒，cue_late_skip_before 为 0.5 秒（和 kit 渲染日志里的 CUE LATE 一致）。",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cue_late": {
              "description": "有限秒数。NaN 报 SS100，检查器改用默认 0.4。",
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "cue_late_skip_before": {
              "description": "有限秒数。NaN 报 SS100，检查器改用默认 0.5。",
              "type": "number",
              "minimum": 0,
              "maximum": 5
            }
          }
        },
        "segmented": {
          "type": "boolean"
        },
        "step_hold": {
          "description": "segmented 为真时，每个子步（step 动作）结束定格的秒数，默认 1.0",
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "subtitles": {
          "description": "字幕：burned 烧进画面（默认，另出一份画面干净、带软字幕轨的副本）| soft 只封装可关的软字幕轨 | none 不出",
          "enum": [
            "burned",
            "soft",
            "none"
          ]
        },
        "min_font": {
          "type": "integer",
          "minimum": 12,
          "maximum": 96
        },
        "lang": {
          "description": "旁白和画面文字的语言：zh（默认）| en。一般不手写，由 localize(doc, \"en\") 设上",
          "enum": [
            "zh",
            "en"
          ]
        }
      }
    },
    "layout": {
      "description": "布局约束：只写关系，不写坐标（at 是受限的逃生口）。",
      "type": "object",
      "properties": {
        "in": {
          "enum": [
            "top",
            "stage",
            "footer",
            "side"
          ]
        },
        "below": {
          "$ref": "#/$defs/selector"
        },
        "above": {
          "$ref": "#/$defs/selector"
        },
        "left_of": {
          "$ref": "#/$defs/selector"
        },
        "right_of": {
          "$ref": "#/$defs/selector"
        },
        "within": {
          "$ref": "#/$defs/selector"
        },
        "over": {
          "$ref": "#/$defs/selector"
        },
        "gap": {
          "enum": [
            "xs",
            "sm",
            "md",
            "lg",
            "xl"
          ]
        },
        "align": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "x": {
              "$ref": "#/$defs/selector"
            },
            "y": {
              "$ref": "#/$defs/selector"
            }
          }
        },
        "size": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "max_width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "max_height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        },
        "pin": {
          "enum": [
            "top"
          ]
        },
        "allow": {
          "description": "有意为之的版式例外：kit 的字形级检查（inspect）不报。cross：线穿过文字；overlap：文字压住文字（true = 和任何对象，列表 = 只和这些对象，对称）；small：小字；clip：伸出画面。",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "cross": {
              "$ref": "#/$defs/allowTargets"
            },
            "overlap": {
              "$ref": "#/$defs/allowTargets"
            },
            "small": {
              "const": true
            },
            "clip": {
              "const": true
            }
          }
        },
        "at": {
          "description": "绝对坐标逃生口：insight 线禁止，其余警告。",
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "allowTargets": {
      "oneOf": [
        {
          "const": true
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/objectId"
          }
        }
      ]
    },
    "objectDef": {
      "oneOf": [
        {
          "$ref": "#/$defs/basicObject"
        },
        {
          "$ref": "#/$defs/widgetObject"
        },
        {
          "$ref": "#/$defs/clipObject"
        }
      ]
    },
    "basicObject": {
      "type": "object",
      "required": [
        "type"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/layout"
        }
      ],
      "properties": {
        "type": {
          "enum": [
            "text",
            "math",
            "shape",
            "axes",
            "numberline",
            "grid",
            "group",
            "readout"
          ]
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "tex": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "enum": [
            "circle",
            "square",
            "rectangle",
            "polygon",
            "line",
            "arrow",
            "dot"
          ]
        },
        "side": {
          "description": "shape：square 的边长、line / arrow 的长度（水平方向，不写 points 时）；rectangle 写 [宽, 高]。单位是画面单位（画面高 8），排版时整体随区域缩放",
          "anyOf": [
            {
              "type": [
                "string",
                "number"
              ]
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          ]
        },
        "radius": {
          "description": "shape：circle / dot 的半径（画面单位）",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "points": {
          "description": "shape：polygon 的顶点（至少三个）或 line / arrow 的起点和终点（两个），[x, y]，y 向上；只表示形状，位置由布局决定",
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/objectId"
          },
          "minItems": 1
        },
        "level": {
          "description": "字号层级（语义，不是数字）：display 大标题 / title 标题 / body 正文 / caption 注释",
          "enum": [
            "display",
            "title",
            "body",
            "caption"
          ]
        },
        "value": {
          "$ref": "#/$defs/expr",
          "description": "readout：显示的值（表达式，可引用参数）"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "readout：值前面的文字；shape：图形的标注（圆、多边形写在中间，线、箭头写在中点上方，点写在右上）。都可混排 $...$ 公式"
        },
        "digits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6,
          "description": "readout：小数位数（默认 2）"
        },
        "format": {
          "enum": [
            "decimal",
            "fraction"
          ],
          "description": "readout：decimal 小数 | fraction 能写成分母不超过 12 的分数时写成分数"
        }
      },
      "unevaluatedProperties": false
    },
    "clipObject": {
      "description": "外部画面：mp4/mov 或 PNG/JPEG 帧序列，只能当背景板或模拟画面。画面上的字和公式仍用 text / math，不能烤进素材。",
      "type": "object",
      "required": [
        "type",
        "src",
        "kind",
        "content_kind"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/layout"
        }
      ],
      "properties": {
        "type": {
          "const": "clip"
        },
        "src": {
          "description": "相对场景文件的路径：kind video 时是 .mp4 / .mov 文件；kind frames 时是只含 PNG/JPEG 的目录。帧按文件名自然排序（1.png、2.png、10.png），和 moxian collect_frames() 一致。",
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "video",
            "frames"
          ]
        },
        "content_kind": {
          "description": "素材里有什么。只能是 plate（空镜/钩子）、simulation（物理模拟）、broll（无字空镜）。text / formula 等会被检查器拒绝。",
          "type": "string",
          "minLength": 1
        },
        "trim": {
          "description": "源时间轴上的入点/出点（秒）。in 默认 0；out 默认到素材结尾。",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "in": {
              "type": "number",
              "minimum": 0
            },
            "out": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "rate": {
          "description": "播放速率，默认 1。裁切按源时间，速率只改变播完 trim 窗口要多久。",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4
        },
        "fps": {
          "description": "帧序列的帧率。kind: frames 时必填。视频不写，由容器自己的帧率决定。帧文件按文件名自然排序（1、2、10）。",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "fit": {
          "description": "放进布局槽位的方式，默认 contain。",
          "enum": [
            "contain",
            "cover",
            "stretch"
          ]
        },
        "opacity": {
          "description": "整体不透明度，默认 1。",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "z": {
          "description": "z-order，和墨线 Node.z 一致：小的先画。不写时 kit 用 -1，让底板落在矢量对象后面。",
          "type": "number"
        },
        "end": {
          "description": "trim 窗口播完之后：hold 停在最后一帧（默认），loop 回到 trim.in。",
          "enum": [
            "loop",
            "hold"
          ]
        },
        "start": {
          "description": "成片时间轴上，源时间 trim.in 对准的秒数，默认 0。早于 start 不画出这一帧。",
          "type": "number",
          "minimum": 0
        },
        "muted": {
          "description": "只能为 true。素材音轨不参与合成；不写时 kit 也按静音处理。",
          "const": true
        },
        "explain": {
          "description": "forbid（默认）：讲解 beat 里不能占住主讲区 stage。allow：明确允许（例如这段模拟就是讲解本身）。",
          "enum": [
            "forbid",
            "allow"
          ]
        }
      },
      "unevaluatedProperties": false
    },
    "widgetObject": {
      "type": "object",
      "required": [
        "widget"
      ],
      "not": {
        "required": [
          "type"
        ]
      },
      "allOf": [
        {
          "$ref": "#/$defs/layout"
        },
        {
          "if": {
            "properties": {
              "widget": {
                "pattern": "^dissect(@[0-9]+)?$"
              }
            },
            "required": [
              "widget"
            ]
          },
          "then": {
            "$ref": "#/$defs/dissectParams"
          }
        }
      ],
      "properties": {
        "widget": {
          "description": "组件名，可带版本：diff_table 或 diff_table@1",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(@[0-9]+)?$"
        },
        "role": {
          "$ref": "#/$defs/role"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/literal"
      }
    },
    "beat": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/beatId"
        },
        "role": {
          "description": "hook：这一段是钩子，不是讲解。id 为 Hook 的 beat 不必再写。",
          "enum": [
            "hook"
          ]
        },
        "plate": {
          "description": "allow：这一段明确允许主讲区里放 clip 底板。",
          "const": "allow"
        },
        "say": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sentence"
          }
        },
        "do": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "pause": {
          "$ref": "#/$defs/pause"
        },
        "shows": {
          "anyOf": [
            {
              "$ref": "#/$defs/showKind"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/showKind"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        },
        "custom": {
          "$ref": "#/$defs/custom"
        }
      }
    },
    "showKind": {
      "enum": [
        "misconception",
        "non_example",
        "landing"
      ]
    },
    "sentence": {
      "type": "object",
      "required": [
        "pace",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "pace": {
          "enum": [
            "normal",
            "brisk",
            "slow",
            "ask"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "description": "这句的英文：中文版里是双语字幕的第二行（不念）；英文版（localize 成 en）里是要念的旁白，书签要和 text 一致",
          "type": "string",
          "minLength": 1
        },
        "hold": {
          "description": "这句说完之后的句间静音（秒），有限数，覆盖标点默认值。必须落在该标点的允许区间里，见设计稿 §7.8。NaN 报 SS485。",
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "timeRef": {
      "description": "句子 id 或下标，可接 @书签 和 +秒数：s1、s1@d0、0、s1+0.5",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^([A-Za-z_][A-Za-z0-9_]*|[0-9]+)(@[A-Za-z_][A-Za-z0-9_]*)?(\\+[0-9]+(\\.[0-9]+)?)?$"
        }
      ]
    },
    "action": {
      "type": "object",
      "required": [
        "act"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "at"
          ]
        },
        {
          "required": [
            "after"
          ]
        },
        {
          "required": [
            "with"
          ]
        }
      ],
      "allOf": [
        {
          "$ref": "#/$defs/segmentArgs"
        }
      ],
      "properties": {
        "at": {
          "$ref": "#/$defs/timeRef"
        },
        "after": {
          "const": "prev"
        },
        "with": {
          "const": "prev"
        },
        "act": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "target": {
          "$ref": "#/$defs/selector"
        },
        "from": {
          "$ref": "#/$defs/selector"
        },
        "to": {
          "$ref": "#/$defs/selector"
        },
        "match": {
          "description": "transform：tex 按同名片段 #id 配对（配上的平移缩放过去，新片段淡入，消失的淡出）；auto 两边有同名片段时同 tex，否则整体变形；shape 整体变形。只管配对，不替换源：要源淡出请写 replace: true",
          "enum": [
            "tex",
            "shape",
            "auto"
          ]
        },
        "replace": {
          "description": "transform：true 时源（from）在变形期间淡出，结束后不再可见（等于同时 hide）；默认 false（源保持不动），不管 match 写的是什么",
          "type": "boolean"
        },
        "style": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "args": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/literal"
          }
        },
        "dur": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "const": "fit"
            }
          ]
        },
        "ease": {
          "enum": [
            "linear",
            "smooth",
            "in",
            "out",
            "in_out"
          ],
          "description": "tween 的缓动（默认 smooth）"
        },
        "allow_late": {
          "description": "true：这一条视觉提示允许晚于旁白书签，不报 SS480。",
          "const": true
        }
      }
    },
    "pause": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "predict",
            "think",
            "segment"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "hold": {
          "description": "有限秒数。NaN 和没有上界的 Infinity 报 SS486。",
          "type": "number",
          "minimum": 0
        },
        "app_item": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "type": {
            "enum": [
              "predict",
              "think"
            ]
          }
        }
      },
      "then": {
        "required": [
          "prompt"
        ]
      }
    },
    "custom": {
      "type": "object",
      "required": [
        "backend",
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "backend": {
          "enum": [
            "manim"
          ]
        },
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
        },
        "args": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/literal"
          }
        }
      }
    },
    "paramName": {
      "type": "string",
      "pattern": "^[A-Za-z]+(_[A-Za-z0-9]+)?$",
      "description": "参数名：字母，可带下标 _0、_max（k、theta、x_0）。不能用 x、pi、e 和函数名。"
    },
    "paramDef": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "number"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        }
      ]
    },
    "expr": {
      "description": "数，或白名单表达式（四则、乘方、括号、sin cos tan exp ln log sqrt abs、pi e 和声明过的参数）",
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      ]
    },
    "dissectPoint": {
      "description": "图形坐标里的一个点 [x, y]（y 向上）",
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "dissectParams": {
      "description": "剖分组件 dissect 的参数（设计稿 §6.6）。几何是否成立（切线是否切开、边是否存在）由语义检查 SS420–SS439 负责。",
      "required": [
        "shapes"
      ],
      "properties": {
        "shapes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "polygon": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/dissectPoint"
                },
                "minItems": 3
              },
              "rect": {
                "type": "array",
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              },
              "circle": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "sector": {
                "type": "object",
                "required": [
                  "r",
                  "from",
                  "to"
                ],
                "additionalProperties": false,
                "properties": {
                  "r": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "from": {
                    "type": "number"
                  },
                  "to": {
                    "type": "number"
                  }
                }
              },
              "dots": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "maxProperties": 1,
                "properties": {
                  "rows": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "points": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/dissectPoint"
                    }
                  }
                }
              },
              "at": {
                "$ref": "#/$defs/dissectPoint"
              },
              "hidden": {
                "type": "boolean"
              },
              "role": {
                "$ref": "#/$defs/role"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "description": "面积标签，写在块的重心处，始终正立"
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "at",
                    "text"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "at": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/dissectPoint"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "description": "边长标签：at 是块原坐标里的一条边，标签放在边外侧"
              }
            }
          }
        },
        "cuts": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "piece",
              "into"
            ],
            "additionalProperties": false,
            "properties": {
              "piece": {
                "$ref": "#/$defs/name"
              },
              "line": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/dissectPoint"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "path": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/dissectPoint"
                },
                "minItems": 2
              },
              "sectors": {
                "type": "integer",
                "minimum": 2,
                "maximum": 360
              },
              "from": {
                "type": "number"
              },
              "into": {
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/name"
                    },
                    "minItems": 2
                  },
                  {
                    "$ref": "#/$defs/name"
                  }
                ]
              }
            }
          }
        },
        "copies": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/name"
          }
        },
        "guides": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "$ref": "#/$defs/dissectPoint"
              },
              "to": {
                "$ref": "#/$defs/dissectPoint"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "$ref": "#/$defs/role"
              },
              "solid": {
                "type": "boolean"
              },
              "side": {
                "enum": [
                  "above",
                  "below",
                  "left",
                  "right"
                ]
              }
            }
          }
        },
        "merges": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "pieces"
            ],
            "additionalProperties": false,
            "properties": {
              "pieces": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/name"
                },
                "minItems": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "$ref": "#/$defs/role"
              }
            }
          }
        },
        "pieces": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "role": {
                "$ref": "#/$defs/role"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "description": "面积标签，写在块的重心处，始终正立"
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "at",
                    "text"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "at": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/dissectPoint"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "description": "边长标签：at 是块原坐标里的一条边，标签放在边外侧"
              }
            }
          }
        },
        "view": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dissectPoint"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "segmentArgs": {
      "description": "分段相关动作的参数：ghost 残影、unghost、step 子步定格、pin 常驻。其他动作不受影响。",
      "allOf": [
        {
          "if": {
            "required": ["act"],
            "properties": {"act": {"const": "ghost"}}
          },
          "then": {
            "properties": {
              "args": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "place": {"enum": ["stay", "above", "below", "left_of", "right_of"]},
                  "gap": {"enum": ["xs", "sm", "md", "lg", "xl"]},
                  "scale": {"type": "number", "minimum": 0.3, "maximum": 1},
                  "opacity": {"type": "number", "minimum": 0.1, "maximum": 0.6},
                  "labels": {"type": "boolean", "description": "false：残影不带组件的标注（刻度数字、箭头和点的名字），只留图形"}
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["act"],
            "properties": {"act": {"const": "step"}}
          },
          "then": {
            "properties": {
              "args": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "hold": {"type": "number", "minimum": 0, "maximum": 10}
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["act"],
            "properties": {"act": {"enum": ["unghost", "pin"]}}
          },
          "then": {
            "not": {"required": ["args"]}
          }
        }
      ]
    }
  }
}
